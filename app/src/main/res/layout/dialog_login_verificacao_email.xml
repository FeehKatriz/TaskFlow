<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Ícone de Alerta -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_email"
            app:tint="@color/Principal" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Email não verificado"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Mensagem -->
        <TextView
            android:id="@+id/txtEmailEnviado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Você ainda não verificou seu email"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <!-- Instruções -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Para acessar sua conta, você precisa verificar seu email. Clique no link que enviamos para ativar sua conta."
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Botão Reenviar -->
        <Button
            android:id="@+id/btnReenviarEmail"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Reenviar email de verificação"
            android:textColor="@color/Principal"
            android:textStyle="bold" />

        <!-- Botão Entendi -->
        <Button
            android:id="@+id/btnEntendi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/Secundaria"
            android:text="Entendi"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>