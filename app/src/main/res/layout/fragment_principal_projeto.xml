<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.projeto.ProjetosFragment">

    <!-- Título da tela -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Meus Projetos"
        android:textColor="@color/black"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- RecyclerView para listar projetos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProjetos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        tools:listitem="@layout/reusable_layout_meus_projetos" />

    <!-- Estado vazio (quando não há projetos) -->
    <LinearLayout
        android:id="@+id/layoutEstadoVazio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:alpha="0.5"
            android:src="@drawable/logotask" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nenhum projeto ainda"
            android:textColor="@color/Principal"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Crie seu primeiro projeto ou entre em um existente usando o código"
            android:textAlignment="center"
            android:textColor="#757575"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- FAB para criar novo projeto -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCriarProjeto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="Criar Novo Projeto"
        android:src="@drawable/add"
        app:backgroundTint="@color/Principal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

    <!-- FAB para entrar em projeto existente -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEntrarProjeto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:contentDescription="Entrar em Projeto"
        android:src="@drawable/usericone"
        app:backgroundTint="@color/Principal"
        app:layout_constraintBottom_toTopOf="@+id/fabCriarProjeto"
        app:layout_constraintEnd_toEndOf="@+id/fabCriarProjeto"
        app:layout_constraintStart_toStartOf="@+id/fabCriarProjeto"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>